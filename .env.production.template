# Copy to .env.production before running docker compose.
# Host path containing roms/ and firmware/ directories.
# Example Windows value: D:/GameHubData
# Example Linux value: /srv/gamehub/data
GAMEHUB_DATA_HOST_PATH=CHANGE_ME

# Host port to expose GAMEHUB server.
GAMEHUB_SERVER_PORT=8000

# Server image repository (official default).
# Override for forks/private registries.
GAMEHUB_SERVER_IMAGE=ghcr.io/epurn/gamehub-server

# Index cache TTL in seconds (0 = startup/manual refresh only).
GAMEHUB_INDEX_REFRESH_SECONDS=0

# Optional path for persistent index hash cache database.
# Default in compose is /app/.cache/gamehub/hash-cache.sqlite3
# (inside named volume gamehub-hash-cache-v2).
# Override only if you want a custom location.
GAMEHUB_HASH_CACHE_PATH=

# Image tag override for deployments using published images.
GAMEHUB_IMAGE_TAG=latest
