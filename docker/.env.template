# Copy to .env before running docker compose.
# Host path containing roms/ and firmware/ directories.
# Example Windows value: D:/GameHubData
# Example Linux value: /srv/gamehub/data
GAMEHUB_DATA_HOST_PATH=CHANGE_ME

# Host port to expose GAMEHUB server.
GAMEHUB_SERVER_PORT=8000

# Host interface to bind for published port access.
# Keep 127.0.0.1 for single-host/local verification, set a trusted LAN IP
# for other machines on your network, or opt into 0.0.0.0 explicitly.
GAMEHUB_SERVER_BIND_ADDRESS=127.0.0.1

# Server image repository (official default).
# Override for forks/private registries.
GAMEHUB_SERVER_IMAGE=ghcr.io/epurn/gamehub-server

# Background poll interval for detecting ROM/firmware changes (0 = disable polling).
GAMEHUB_INDEX_POLL_SECONDS=1

# Changed files must remain unchanged for this many seconds before auto-reindex.
GAMEHUB_INDEX_STABLE_SECONDS=2

# Optional extra cache TTL in seconds (0 = no TTL-based rebuilds).
GAMEHUB_INDEX_REFRESH_SECONDS=0

# Optional path for persistent index hash cache database.
# Default in compose is /app/.cache/gamehub/hash-cache.sqlite3
# (inside named volume gamehub-hash-cache-v2).
# Override only if you want a custom location.
GAMEHUB_HASH_CACHE_PATH=

# Keep the newest server-generated save backups per save file.
GAMEHUB_BACKUP_KEEP_LIMIT=3

# Optional max save upload size in bytes.
# Leave blank to use the server default (128 MiB).
GAMEHUB_MAX_SAVE_UPLOAD_BYTES=

# Image tag override for deployments using published images.
# Prefer a pinned release tag (for example v1.5.1) on real servers.
GAMEHUB_IMAGE_TAG=latest
